[Unit]
Description=vitalsd - server vitals HTTP daemon
# Wait for udev to finish device enumeration: amdgpu initializes cards
# asynchronously and a probe at network.target can miss late ones.
After=network.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
ExecStart=@REPO@/.venv/bin/python -m vitalsd
WorkingDirectory=@REPO@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
